{#- 邮件客户端普遍会剥离 <style> 标签，因此全部使用内联样式 -#}
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;background:#f5f6f8;padding:24px 12px;">
  <div style="max-width:640px;margin:0 auto;background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e3e6ea;">

    <div style="padding:20px 24px;border-bottom:1px solid #eceff2;">
      <div style="font-size:17px;font-weight:600;color:#1a1d21;">美股指数日报</div>
      <div style="font-size:12px;color:#8a9199;margin-top:5px;">
        收盘日 {{ trade_day }}（美东）&nbsp;·&nbsp;生成于 {{ generated_at }}（北京时间）
      </div>
    </div>

    {% for r in reports %}
    <div style="padding:18px 24px;{% if not loop.last %}border-bottom:1px solid #f0f2f4;{% endif %}">

      <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
        <tr>
          <td style="font-size:15px;font-weight:600;color:#1a1d21;">
            {{ r.name }}
            {%- if r.is_new_ath %}
            <span style="display:inline-block;margin-left:8px;font-size:11px;font-weight:600;color:#ffffff;background:#d94040;border-radius:3px;padding:2px 7px;vertical-align:middle;">历史新高</span>
            {%- endif %}
          </td>
          <td align="right" style="font-size:22px;font-weight:600;color:#1a1d21;letter-spacing:-0.3px;">
            {{ '{:,.2f}'.format(r.last_close) }}
          </td>
        </tr>
        <tr>
          <td style="font-size:12px;color:#8a9199;padding-top:4px;">
            较昨收（{{ r.prev_day }} {{ '{:,.2f}'.format(r.prev_close) }}）
          </td>
          <td align="right" style="font-size:14px;font-weight:600;padding-top:4px;color:{{ color(r.day_pct) }};">
            {{ signed(r.day_change) }}&nbsp;&nbsp;{{ signed(r.day_pct) }}%
          </td>
        </tr>
      </table>

      <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:14px;background:#fafbfc;border-radius:6px;">
        <tr>
          <td style="padding:10px 12px;font-size:12px;color:#6b7280;">
            距历史最高收盘价
            <span style="color:#9aa1a9;">（{{ '{:,.2f}'.format(r.ath_close) }} · {{ r.ath_day }}）</span>
          </td>
          <td align="right" style="padding:10px 12px;font-size:14px;font-weight:600;color:{{ color(r.drawdown_pct) }};">
            {% if r.is_new_ath %}—{% else %}{{ signed(r.drawdown_pct) }}%{% endif %}
          </td>
        </tr>
        {% if not r.is_new_ath %}
        <tr>
          <td style="padding:0 12px 10px;font-size:12px;color:#6b7280;">距上次新高</td>
          <td align="right" style="padding:0 12px 10px;font-size:13px;color:#4b5563;">
            {{ r.trading_days_since_ath }} 个交易日
          </td>
        </tr>
        {% endif %}
      </table>

      <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:10px;">
        <tr>
          {% for n, pct in r.lookbacks.items() %}
          <td align="center" style="padding:6px 4px;">
            <div style="font-size:11px;color:#9aa1a9;">近 {{ n }} 日</div>
            <div style="font-size:13px;font-weight:600;margin-top:2px;color:{{ color(pct) }};">
              {% if pct is none %}—{% else %}{{ signed(pct) }}%{% endif %}
            </div>
          </td>
          {% endfor %}
        </tr>
      </table>

    </div>
    {% endfor %}

    <div style="padding:14px 24px;background:#fafbfc;border-top:1px solid #eceff2;font-size:11px;color:#9aa1a9;line-height:1.6;">
      历史最高点按收盘价计算，涨跌幅基于上一交易日收盘价。<br>
      统计区间：{% for r in reports %}{{ r.name }} {{ r.data_start }} 起{{ "、" if not loop.last }}{% endfor %}。<br>
      数据源：{{ sources }}。
    </div>

  </div>
</div>
